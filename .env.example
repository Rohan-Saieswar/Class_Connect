# Section-Connect Environment Configuration

# Database: SQLite for local dev, PostgreSQL for production
# Example for PostgreSQL: postgresql://user:password@localhost:5432/section_connect?schema=public
# Example for SQLite: file:./dev.db
DATABASE_URL="file:./dev.db"

# Authentication & Security
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth web client; add this callback URL to the existing OAuth client:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
GOOGLE_CLASSROOM_REDIRECT_URI="http://localhost:3000/api/classroom/callback"

# Required in production to encrypt per-user Google Classroom credentials.
CLASSROOM_TOKEN_ENCRYPTION_KEY="replace-with-a-long-random-secret"
CRON_SECRET="replace-with-a-separate-random-secret"
APP_BASE_URL="http://localhost:3000"
CLASSROOM_SYNC_INTERVAL_SECONDS="900"

# Initial Class Representatives for J-Connect (Seeded securely)
INITIAL_CR_EMAIL_1="cr1_section_j@srmap.edu.in"
INITIAL_CR_EMAIL_2="cr2_section_j@srmap.edu.in"

# Outbound Email Service (SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="smtp_username_placeholder"
SMTP_PASSWORD="smtp_password_placeholder"
EMAIL_FROM="Section-Connect Notifications <notifications@srmap.edu.in>"

# Cloud Storage Configuration (S3 / R2 / GCS / Local)
STORAGE_PROVIDER="local"
STORAGE_BUCKET="section-connect-uploads"
STORAGE_ACCESS_KEY="storage_access_key_placeholder"
STORAGE_SECRET_KEY="storage_secret_key_placeholder"

# Environment (npm run dev is pinned to port 3000)
NODE_ENV="development"
PORT="3000"
